# ATELIER NOVA — environment configuration
# Copy this file to `.env.local` and fill in real values.

# Canonical site URL — used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ateliernova.fr

# Cinematic hero background video (MP4). When unset, the hero shows the
# still image only. When set, the video autoplays (muted, looped) over
# the still, which remains the poster/fallback.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Contact form submission endpoint (e.g. Formspree, Web3Forms, Resend).
# Receives a JSON POST: { name, email, studio, message }.
# When unset, the form shows a graceful "email us directly" message.
NEXT_PUBLIC_CONTACT_ENDPOINT=
